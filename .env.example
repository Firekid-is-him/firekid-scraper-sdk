# ============================================
# FIREKID SCRAPER CONFIGURATION
# ============================================

# Browser Settings
HEADLESS=true
# Needed when running as root or inside Docker
NO_SANDBOX=false
MAX_QUEUE_WORKERS=5
BROWSER_TIMEOUT=30000

# Cloudflare Bypass
CF_BYPASS=auto
# Options: auto, manual, skip
TURNSTILE_SOLVER=manual
TURNSTILE_TIMEOUT=120000
# Options: skip, manual, 2captcha, capsolver

# Captcha Solver (Optional - for auto-solve)
CAPTCHA_API_KEY=

# Web Server
API_HOST=127.0.0.1
API_PORT=3000
# Required to start the server. Generate with: openssl rand -hex 32
API_KEY=
API_MAX_CONCURRENT=2
API_REQUEST_TIMEOUT=120000
API_COMMAND_DIR=./commands
API_OUTPUT_DIR=./output
# Allow targets on private, loopback and link-local networks
API_ALLOW_PRIVATE_URLS=false

# Proxy
PROXY_ENABLED=false
PROXY_URL=

# Storage
DATA_DIR=./data
PATTERNS_DB=./data/patterns.db
SESSIONS_DB=./data/sessions.db

# Logging
LOG_LEVEL=info
# Options: error, warn, info, debug

# Recording
AUTO_HIDE_AFTER_SOLVE=true
RECORD_SCREENSHOTS=false

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=3600000

# Advanced
ENABLE_TELEMETRY=false
ENABLE_ANALYTICS=false
