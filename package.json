{
  "name": "@firekid/scraper",
  "version": "1.2.0",
  "description": "The most advanced web scraping machine ever built",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Firekid-is-him/firekid-scraper-sdk.git"
  },
  "homepage": "https://github.com/Firekid-is-him/firekid-scraper-sdk#readme",
  "bugs": {
    "url": "https://github.com/Firekid-is-him/firekid-scraper-sdk/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "firekid-scraper": "./dist/bin/firekid-scraper.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prestart": "node scripts/prestart.js",
    "start": "node dist/bin/firekid-scraper.js",
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "keywords": [
    "scraping",
    "playwright",
    "automation",
    "web-scraper",
    "cloudflare-bypass",
    "anti-detection",
    "fingerprinting"
  ],
  "author": "Firekid",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.9.0",
    "better-sqlite3": "^11.0.0",
    "cheerio": "^1.0.0",
    "commander": "^12.1.0",
    "croner": "^9.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "glob": "^14.0.6",
    "js-yaml": "^4.1.0",
    "playwright": "^1.47.0",
    "winston": "^3.13.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "nodemon": "^3.1.4",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
